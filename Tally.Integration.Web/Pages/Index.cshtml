@page
@model IndexModel
@{
    ViewData["Title"] = "Tally Web Tester";
}

<style>
    .page-wrap {
        max-width: 1200px;
        margin: 0 auto;
    }

    .soft-card {
        border: 1px solid #dce3ef;
        border-radius: 14px;
        background: linear-gradient(180deg, #f9fbff 0%, #f4f8ff 100%);
        box-shadow: 0 6px 16px rgba(22, 44, 77, 0.08);
    }

    .result-card {
        border: 1px solid #dbe6da;
        border-radius: 14px;
        background: #f8fcf8;
    }

    .field-title {
        font-weight: 600;
        color: #27384f;
        margin-bottom: 6px;
    }

    textarea.form-control {
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.92rem;
    }

    .tpl-card {
        border: 1px solid #d0d9ee;
        border-radius: 10px;
        background: #f5f8ff;
    }

    .tpl-card .tpl-header {
        cursor: pointer;
        user-select: none;
        font-weight: 600;
        color: #1e3a6e;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 10px;
    }

    .tpl-card .tpl-header:hover { background: #e8eefa; }

    .tpl-json-wrap { border: 1px solid #2d3650; border-radius: 8px; overflow: hidden; }
    .tpl-json-tabbar { padding: 6px 10px 0; background: #252b3d; display: flex; gap: 4px; }
    .tpl-tab { background: transparent; color: #8ba0c8; border: none; border-bottom: 2px solid transparent;
               border-radius: 0; padding: 4px 14px; font-size: 0.82rem; cursor: pointer; }
    .tpl-tab.active { color: #fff; border-bottom-color: #5b8fff; }
    .tpl-json-view { margin: 0; padding: 14px; background: #1e2332; color: #e2e8f0;
                     font-family: Consolas, "Courier New", monospace; font-size: 0.84rem;
                     min-height: 280px; max-height: 420px; overflow: auto; white-space: pre;
                     border: none; line-height: 1.6; }
    .tpl-json-editor { font-family: Consolas, "Courier New", monospace; font-size: 0.84rem;
                       background: #1e2332; color: #e2e8f0; border: none; resize: vertical;
                       border-radius: 0; height: 340px; line-height: 1.6; }
    .tpl-json-editor:focus { outline: none; box-shadow: none; }
    .json-key  { color: #79b8ff; }
    .json-str  { color: #9ecbff; }
    .json-num  { color: #f8c555; }
    .json-bool { color: #ff7b72; }
    .json-null { color: #ff7b72; font-style: italic; }
</style>

<div class="container py-4 page-wrap">
    <div class="soft-card p-4 mb-4">
        <h2 class="mb-2">Tally End-to-End Tester</h2>
        <p class="text-muted mb-0">Choose input type, select voucher, paste payload and mapping JSON, then convert and optionally push to Tally.</p>
    </div>

    <form method="post" id="importForm" novalidate>
        <div class="soft-card p-4">
            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="field-title" asp-for="Input.InputType">Input Type</label>
                    <select id="inputType" class="form-select" asp-for="Input.InputType">
                        <option value="json">JSON</option>
                        <option value="xml">XML</option>
                    </select>
                    <span asp-validation-for="Input.InputType" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label class="field-title" asp-for="Input.VoucherType">Voucher Type</label>
                    <select id="voucherType" class="form-select" asp-for="Input.VoucherType">
                        @foreach (var voucher in Model.SupportedVoucherTypes)
                        {
                            <option value="@voucher">@voucher</option>
                        }
                    </select>
                    <span asp-validation-for="Input.VoucherType" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label class="field-title" asp-for="Input.TallyUrl">Tally URL</label>
                    <input class="form-control" asp-for="Input.TallyUrl" />
                    <span asp-validation-for="Input.TallyUrl" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label class="field-title" asp-for="Input.TimeoutMs">Timeout (ms)</label>
                    <input class="form-control" asp-for="Input.TimeoutMs" />
                    <span asp-validation-for="Input.TimeoutMs" class="text-danger"></span>
                </div>

                <div class="col-md-5">
                    <label class="field-title" asp-for="Input.CompanyName">Company Name (optional)</label>
                    <input class="form-control" asp-for="Input.CompanyName" />
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Input.EnablePush" />
                        <label class="form-check-label" asp-for="Input.EnablePush">Enable Push To Tally</label>
                    </div>
                </div>

                <div class="col-12">
                    <label class="field-title" asp-for="Input.Payload">Input Payload (JSON or XML)</label>
                    <textarea id="payloadBox" class="form-control" rows="11" asp-for="Input.Payload"></textarea>
                    <span asp-validation-for="Input.Payload" class="text-danger"></span>
                    <span id="payloadFormatError" class="text-danger"></span>
                    <div class="mt-2">
                        <button id="loadTemplateBtn" class="btn btn-outline-secondary btn-sm" type="button">Load Payload Template</button>
                    </div>
                </div>

                <div class="col-12">
                    <label class="field-title" asp-for="Input.MappingJson">Mapping JSON (dynamic)</label>
                    <textarea id="mappingBox" class="form-control" rows="11" asp-for="Input.MappingJson"></textarea>
                    <span asp-validation-for="Input.MappingJson" class="text-danger"></span>
                    <span id="mappingFormatError" class="text-danger"></span>
                    <div class="mt-2 d-flex gap-2">
                        <button id="generateMappingBtn" class="btn btn-outline-primary btn-sm" type="button">Generate Mapping from Payload</button>
                        <button id="resetMappingTemplateBtn" class="btn btn-outline-secondary btn-sm" type="button">Reset Mapping Template</button>
                    </div>
                </div>

                <!-- Company Template Editor -->
                <div class="col-12">
                    <div class="tpl-card">
                        <div class="tpl-header" id="tplToggle">
                            <span>&#9881; Company Template Editor</span>
                            <span id="tplChevron">&#9660;</span>
                        </div>
                        <div id="tplBody" style="display:none; padding:14px;">
                            <!-- Toolbar -->
                            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                <label style="font-size:0.83rem; font-weight:600; color:#27384f; white-space:nowrap;">Company:</label>
                                <select id="tplCompanySelect" class="form-select form-select-sm" style="max-width:190px;"></select>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="tplAddCompanyBtn">+ New</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" id="tplDeleteCompanyBtn">Delete</button>
                                <div class="ms-auto d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="tplFormatBtn">Format</button>
                                    <button type="button" class="btn btn-success btn-sm" id="tplApplyBtn">Apply to Mapping JSON</button>
                                </div>
                            </div>
                            <!-- JSON viewer/editor -->
                            <div class="tpl-json-wrap">
                                <div class="tpl-json-tabbar">
                                    <button type="button" class="tpl-tab active" id="tplViewTab">View</button>
                                    <button type="button" class="tpl-tab" id="tplEditTab">Edit</button>
                                </div>
                                <pre id="tplJsonView" class="tpl-json-view"></pre>
                                <textarea id="tplJsonEditor" class="form-control tpl-json-editor" style="display:none;"></textarea>
                            </div>
                            <div id="tplEditorError" class="text-danger mt-2" style="font-size:0.83rem;"></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Convert / Push</button>
                    <button class="btn btn-outline-dark" type="reset">Reset</button>
                </div>
            </div>
        </div>
    </form>

    <div class="result-card p-4 mt-4">
        <h4 class="mb-3">Result</h4>
        <p><strong>Status:</strong> @Model.Result.StatusMessage</p>
        <p><strong>Success:</strong> @Model.Result.Success</p>
        <p><strong>Created:</strong> @Model.Result.Created | <strong>Altered:</strong> @Model.Result.Altered | <strong>Deleted:</strong> @Model.Result.Deleted | <strong>Errors:</strong> @Model.Result.Errors</p>

        @if (Model.Result.ValidationErrors != null && Model.Result.ValidationErrors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <div><strong>Please fix these errors:</strong></div>
                <ul class="mb-0 mt-2">
                    @foreach (var err in Model.Result.ValidationErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

        <div class="mb-3">
            <label class="field-title">Error Message</label>
            <textarea class="form-control" rows="3" readonly>@Model.Result.ErrorMessage</textarea>
        </div>

        <div class="mb-3">
            <label class="field-title">Mapped Request Object (JSON)</label>
            <textarea class="form-control" rows="8" readonly>@Model.Result.RequestObjectJson</textarea>
        </div>

        <div class="mb-3">
            <label class="field-title">Generated Tally XML</label>
            <textarea class="form-control" rows="10" readonly>@Model.Result.RequestXml</textarea>
        </div>

        <div class="mb-3">
            <label class="field-title">Tally Response XML</label>
            <textarea class="form-control" rows="10" readonly>@Model.Result.ResponseXml</textarea>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function() {
        const form = document.getElementById("importForm");
        const inputType = document.getElementById("inputType");
        const voucherType = document.getElementById("voucherType");
        const payloadBox = document.getElementById("payloadBox");
        const mappingBox = document.getElementById("mappingBox");
        const loadTemplateBtn = document.getElementById("loadTemplateBtn");
        const generateMappingBtn = document.getElementById("generateMappingBtn");
        const resetMappingTemplateBtn = document.getElementById("resetMappingTemplateBtn");
        const mappingFormatError = document.getElementById("mappingFormatError");
        const payloadFormatError = document.getElementById("payloadFormatError");

        const jsonTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JsonPayloadTemplate));
        const xmlTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.XmlPayloadTemplate));
        const mappingTemplates = @Html.Raw(Model.MappingTemplatesJson);

        function getTemplate() {
            return inputType.value === "xml" ? xmlTemplate : jsonTemplate;
        }

        function getMappingTemplate() {
            return mappingTemplates[voucherType.value] || mappingTemplates["Sales"];
        }

        function getEffectiveVoucherType() {
            return voucherType.value || "Sales";
        }

        function flattenJsonPaths(input) {
            const paths = [];

            function walk(value, currentPath) {
                if (Array.isArray(value)) {
                    for (let i = 0; i < value.length; i++) {
                        const nextPath = currentPath ? `${currentPath}[${i}]` : `[${i}]`;
                        walk(value[i], nextPath);
                    }
                    return;
                }

                if (value && typeof value === "object") {
                    const keys = Object.keys(value);
                    if (keys.length === 0 && currentPath) {
                        paths.push(currentPath);
                    }

                    keys.forEach(k => {
                        const nextPath = currentPath ? `${currentPath}/${k}` : k;
                        walk(value[k], nextPath);
                    });
                    return;
                }

                if (currentPath) {
                    paths.push(currentPath);
                }
            }

            walk(input, "");
            return Array.from(new Set(paths));
        }

        function extractXmlLeafPaths(xmlText) {
            const parser = new DOMParser();
            const doc = parser.parseFromString(xmlText, "application/xml");
            if (doc.getElementsByTagName("parsererror").length > 0) {
                return null;
            }

            const root = doc.documentElement;
            if (!root) {
                return [];
            }

            const result = [];

            function walk(node, currentPath) {
                const elementChildren = Array.from(node.children || []);
                if (elementChildren.length === 0) {
                    result.push(currentPath);
                    return;
                }

                const group = {};
                for (const child of elementChildren) {
                    const key = child.nodeName;
                    if (!group[key]) {
                        group[key] = [];
                    }
                    group[key].push(child);
                }

                Object.keys(group).forEach(name => {
                    const siblings = group[name];
                    siblings.forEach((child, index) => {
                        const segment = siblings.length > 1 ? `${name}[${index}]` : name;
                        walk(child, `${currentPath}/${segment}`);
                    });
                });
            }

            walk(root, root.nodeName);

            const noRoot = result.map(p => {
                const idx = p.indexOf("/");
                return idx < 0 ? p : p.substring(idx + 1);
            });

            return Array.from(new Set(noRoot));
        }

        function leafNameFromPath(path) {
            if (!path) {
                return "";
            }

            const normalized = path.replace(/\./g, "/");
            const segments = normalized.split("/").filter(Boolean);
            if (segments.length === 0) {
                return path;
            }

            return segments[segments.length - 1].replace(/\[[0-9]+\]$/g, "");
        }

        function toWildcardPath(path) {
            return (path || "").replace(/\[[0-9]+\]/g, "[*]");
        }

        function suggestTallyField(sourceKey) {
            const normalizedPath = toWildcardPath((sourceKey || "").replace(/\\/g, "/"));
            const leaf = leafNameFromPath(sourceKey);
            const key = (leaf || "").toLowerCase();

            if (normalizedPath.includes("party/") && key === "name") {
                return "PARTYLEDGERNAME";
            }
            if (normalizedPath.includes("party/") && key === "gstin") {
                return "PARTYGSTIN";
            }

            if (normalizedPath.includes("ledgerentries/ledger[*]/") && key === "name") {
                return "ALLLEDGERENTRIES.LIST[*]/LEDGERNAME";
            }
            if (normalizedPath.includes("ledgerentries/ledger[*]/") && key === "amount") {
                return "ALLLEDGERENTRIES.LIST[*]/AMOUNT";
            }

            if (normalizedPath.includes("items/item[*]/") && key === "stockitem") {
                return "ALLINVENTORYENTRIES.LIST[*]/STOCKITEMNAME";
            }
            if (normalizedPath.includes("items/item[*]/") && key === "quantity") {
                return "ALLINVENTORYENTRIES.LIST[*]/BILLEDQTY";
            }
            if (normalizedPath.includes("items/item[*]/") && key === "rate") {
                return "ALLINVENTORYENTRIES.LIST[*]/RATE";
            }
            if (normalizedPath.includes("items/item[*]/") && key === "amount") {
                return "ALLINVENTORYENTRIES.LIST[*]/AMOUNT";
            }

            if (key.includes("invoice") && (key.includes("no") || key.includes("number"))) {
                return "VOUCHERNUMBER";
            }
            if (key.includes("voucher") && (key.includes("no") || key.includes("number"))) {
                return "VOUCHERNUMBER";
            }
            if (key === "vouchertype") {
                return "VOUCHERTYPENAME";
            }
            if (key.includes("customer") || key.includes("party") || key.includes("ledger")) {
                return "PARTYLEDGERNAME";
            }
            if (key.includes("date")) {
                return "DATE";
            }
            if (key.includes("amount") || key.includes("total") || key.includes("value")) {
                return "AMOUNT";
            }

            return leaf.toUpperCase().replace(/\s+/g, "");
        }

        function buildMappingsFromKeys(keys) {
            const mappings = {};
            keys.forEach(k => {
                const source = toWildcardPath(k);
                mappings[source] = suggestTallyField(source);
            });
            return mappings;
        }

        function generateMappingFromPayload() {
            clearInlineErrors();
            const payloadText = payloadBox.value || "";
            if (!payloadText.trim()) {
                payloadFormatError.textContent = "Payload is empty. Add payload before generating mapping.";
                return;
            }

            let keys = [];
            if (inputType.value === "json") {
                try {
                    const parsed = JSON.parse(payloadText);
                    keys = flattenJsonPaths(parsed);
                } catch {
                    payloadFormatError.textContent = "Payload must be valid JSON to auto-generate mapping.";
                    return;
                }
            } else {
                const xmlKeys = extractXmlLeafPaths(payloadText);
                if (xmlKeys === null) {
                    payloadFormatError.textContent = "Payload must be valid XML to auto-generate mapping.";
                    return;
                }
                keys = xmlKeys;
            }

            if (!keys || keys.length === 0) {
                mappingFormatError.textContent = "No usable fields found in payload for mapping generation.";
                return;
            }

            const baseTemplateText = getMappingTemplate();
            let mapping;
            try {
                mapping = JSON.parse(baseTemplateText || "{}");
            } catch {
                mapping = {};
            }

            mapping.VoucherType = getEffectiveVoucherType();
            const generatedMappings = buildMappingsFromKeys(keys);
            mapping.Mappings = Object.assign({}, mapping.Mappings || {}, generatedMappings);
            if (!mapping.CompanyTemplates || typeof mapping.CompanyTemplates !== "object") {
                mapping.CompanyTemplates = {};
            }

            mappingBox.value = JSON.stringify(mapping, null, 2);
        }

        function validateJson(text) {
            try {
                JSON.parse(text);
                return true;
            } catch {
                return false;
            }
        }

        function validateXml(text) {
            const parser = new DOMParser();
            const doc = parser.parseFromString(text, "application/xml");
            return doc.getElementsByTagName("parsererror").length === 0;
        }

        function clearInlineErrors() {
            mappingFormatError.textContent = "";
            payloadFormatError.textContent = "";
        }

        function validateBeforeSubmit() {
            clearInlineErrors();
            let valid = true;

            if (!validateJson(mappingBox.value || "")) {
                mappingFormatError.textContent = "Mapping JSON must be valid JSON.";
                valid = false;
            }

            if (inputType.value === "json") {
                if (!validateJson(payloadBox.value || "")) {
                    payloadFormatError.textContent = "Payload must be valid JSON for JSON input type.";
                    valid = false;
                }
            } else {
                if (!validateXml(payloadBox.value || "")) {
                    payloadFormatError.textContent = "Payload must be valid XML for XML input type.";
                    valid = false;
                }
            }

            return valid;
        }

        function applyTemplateIfEmpty() {
            if (!payloadBox.value || payloadBox.value.trim().length === 0) {
                payloadBox.value = getTemplate();
            }
        }

        inputType.addEventListener("change", function () {
            payloadBox.value = getTemplate();
        });

        voucherType.addEventListener("change", function() {
            mappingBox.value = getMappingTemplate();
        });

        loadTemplateBtn.addEventListener("click", function () {
            payloadBox.value = getTemplate();
        });

        generateMappingBtn.addEventListener("click", generateMappingFromPayload);

        resetMappingTemplateBtn.addEventListener("click", function() {
            mappingBox.value = getMappingTemplate();
            clearInlineErrors();
        });

        form.addEventListener("submit", function(e) {
            if (!validateBeforeSubmit()) {
                e.preventDefault();
            }
        });

        applyTemplateIfEmpty();
        if (!mappingBox.value || mappingBox.value.trim().length === 0) {
            mappingBox.value = getMappingTemplate();
        }

        // ── Company Template JSON Viewer ───────────────────────────────────
        const tplToggle        = document.getElementById("tplToggle");
        const tplChevron       = document.getElementById("tplChevron");
        const tplBody          = document.getElementById("tplBody");
        const tplCompanySelect = document.getElementById("tplCompanySelect");
        const tplEditorError   = document.getElementById("tplEditorError");
        const tplApplyBtn      = document.getElementById("tplApplyBtn");
        const tplAddCompanyBtn = document.getElementById("tplAddCompanyBtn");
        const tplDeleteBtn     = document.getElementById("tplDeleteCompanyBtn");
        const tplFormatBtn     = document.getElementById("tplFormatBtn");
        const tplViewTab       = document.getElementById("tplViewTab");
        const tplEditTab       = document.getElementById("tplEditTab");
        const tplJsonView      = document.getElementById("tplJsonView");
        const tplJsonEditor    = document.getElementById("tplJsonEditor");

        let tplOpen    = false;
        let tplInEdit  = false;

        // ── toggle panel
        tplToggle.addEventListener("click", function () {
            tplOpen = !tplOpen;
            tplBody.style.display = tplOpen ? "block" : "none";
            tplChevron.innerHTML  = tplOpen ? "&#9650;" : "&#9660;";
            if (tplOpen) { tplLoadAll(); }
        });

        function parseMappingJson() {
            try { return JSON.parse(mappingBox.value || "{}"); } catch { return null; }
        }

        // ── syntax highlight a JSON string → HTML
        function syntaxHL(json) {
            const esc = json.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
            return esc.replace(
                /("(?:\\[\s\S]|[^\\"])*"(?:\s*:)?|\b(?:true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g,
                function(m) {
                    if (/^"/.test(m)) return /:$/.test(m)
                        ? `<span class="json-key">${m}</span>`
                        : `<span class="json-str">${m}</span>`;
                    if (/true|false/.test(m)) return `<span class="json-bool">${m}</span>`;
                    if (/null/.test(m))       return `<span class="json-null">${m}</span>`;
                    return `<span class="json-num">${m}</span>`;
                }
            );
        }

        // ── populate company dropdown from mapping
        function tplLoadAll() {
            tplEditorError.textContent = "";
            const mapping = parseMappingJson();
            if (!mapping) { tplEditorError.textContent = "Mapping JSON is invalid — fix it first."; return; }

            const templates = mapping.CompanyTemplates || {};
            const prevKey   = tplCompanySelect.value;
            tplCompanySelect.innerHTML = "";

            const keys = Object.keys(templates);
            if (keys.length === 0) {
                const o = document.createElement("option"); o.value=""; o.textContent="(no templates)";
                tplCompanySelect.appendChild(o);
            } else {
                keys.forEach(k => {
                    const o = document.createElement("option"); o.value=k; o.textContent=k;
                    if (k === prevKey) o.selected = true;
                    tplCompanySelect.appendChild(o);
                });
            }
            tplShowSelected(templates);
        }

        // ── show selected company profile in viewer/editor
        function tplShowSelected(templates) {
            const key     = tplCompanySelect.value;
            const profile = (key && templates && templates[key])
                ? templates[key]
                : { StrictMode: true, Defaults: {}, RequiredTargets: [] };

            const pretty = JSON.stringify(profile, null, 2);
            tplJsonView.innerHTML   = syntaxHL(pretty);
            tplJsonEditor.value     = pretty;
        }

        tplCompanySelect.addEventListener("change", function () {
            const mapping = parseMappingJson();
            if (!mapping) return;
            tplShowSelected(mapping.CompanyTemplates || {});
        });

        // ── View / Edit tabs
        tplViewTab.addEventListener("click", function () {
            tplInEdit = false;
            tplViewTab.classList.add("active");  tplEditTab.classList.remove("active");
            tplJsonView.style.display   = "block"; tplJsonEditor.style.display = "none";
            // refresh view from editor content
            try {
                const pretty = JSON.stringify(JSON.parse(tplJsonEditor.value), null, 2);
                tplJsonView.innerHTML = syntaxHL(pretty);
                tplJsonEditor.value   = pretty;
                tplEditorError.textContent = "";
            } catch { tplEditorError.textContent = "JSON in editor is invalid."; }
        });

        tplEditTab.addEventListener("click", function () {
            tplInEdit = true;
            tplEditTab.classList.add("active"); tplViewTab.classList.remove("active");
            tplJsonEditor.style.display = "block"; tplJsonView.style.display = "none";
            tplEditorError.textContent = "";
        });

        // ── Format button (pretty-print editor content)
        tplFormatBtn.addEventListener("click", function () {
            try {
                const pretty = JSON.stringify(JSON.parse(tplJsonEditor.value), null, 2);
                tplJsonEditor.value = pretty;
                tplJsonView.innerHTML = syntaxHL(pretty);
                tplEditorError.textContent = "";
            } catch { tplEditorError.textContent = "Cannot format — invalid JSON."; }
        });

        // ── Add new company
        tplAddCompanyBtn.addEventListener("click", function () {
            const name = prompt("Company key (e.g. TEAM-X or * for wildcard fallback):");
            if (!name || !name.trim()) return;
            const mapping = parseMappingJson();
            if (!mapping) { tplEditorError.textContent = "Fix Mapping JSON first."; return; }
            if (!mapping.CompanyTemplates) mapping.CompanyTemplates = {};
            if (!mapping.CompanyTemplates[name.trim()]) {
                mapping.CompanyTemplates[name.trim()] = { StrictMode: true, Defaults: {}, RequiredTargets: [] };
            }
            mappingBox.value = JSON.stringify(mapping, null, 2);
            tplLoadAll();
            tplCompanySelect.value = name.trim();
            tplShowSelected(mapping.CompanyTemplates);
        });

        // ── Delete company
        tplDeleteBtn.addEventListener("click", function () {
            const key = tplCompanySelect.value;
            if (!key) return;
            if (!confirm("Delete company template '" + key + "'?")) return;
            const mapping = parseMappingJson();
            if (!mapping || !mapping.CompanyTemplates) return;
            delete mapping.CompanyTemplates[key];
            mappingBox.value = JSON.stringify(mapping, null, 2);
            tplLoadAll();
        });

        // ── Apply: merge editor JSON back into CompanyTemplates in mapping
        tplApplyBtn.addEventListener("click", function () {
            tplEditorError.textContent = "";
            const key = tplCompanySelect.value;
            if (!key) { tplEditorError.textContent = "No company selected."; return; }

            let profile;
            try { profile = JSON.parse(tplJsonEditor.value); }
            catch { tplEditorError.textContent = "JSON in editor is invalid — fix it before applying."; return; }

            const mapping = parseMappingJson();
            if (!mapping) { tplEditorError.textContent = "Mapping JSON is invalid."; return; }
            if (!mapping.CompanyTemplates) mapping.CompanyTemplates = {};
            mapping.CompanyTemplates[key] = profile;

            mappingBox.value = JSON.stringify(mapping, null, 2);

            // refresh view
            const pretty = JSON.stringify(profile, null, 2);
            tplJsonView.innerHTML = syntaxHL(pretty);
            tplEditorError.textContent = "";

            const badge = document.createElement("span");
            badge.className = "text-success ms-2"; badge.style.fontSize = "0.82rem";
            badge.textContent = "Applied ✓";
            tplApplyBtn.parentNode.appendChild(badge);
            setTimeout(() => badge.remove(), 2000);
        });

        // ── When mapping box changes externally, reload panel if open
        mappingBox.addEventListener("input", function () {
            if (tplOpen) tplLoadAll();
        });
        // ──────────────────────────────────────────────────────────────────
    })();
    </script>
}
